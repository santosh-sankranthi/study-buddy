# Copy this file to .env and fill in your key(s). NEVER commit the real .env.

# Which provider to use first: "openrouter" (default) or "opencode".
# The other provider, if configured, is used automatically as a fallback.
LLM_PROVIDER=openrouter

# ── OpenRouter (default) ─────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional: comma separated fallbacks used when the router/model is unavailable.
# Check https://openrouter.ai/models (filter: prompt price = free) for live IDs.
# OPENROUTER_FALLBACK_MODELS=qwen/qwen-2.5-72b-instruct:free,meta-llama/llama-3.3-70b-instruct:free

# ── OpenCode Zen Go gateway ──────────────────────────────────────────────────
# OpenAI-compatible. Needs the key plus an x-opencode-session header, which the
# client sets for you. Key falls back to OPENAI_API_KEY if OPENCODE_API_KEY is empty.
# OPENCODE_API_KEY=
# OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
# OPENCODE_MODEL=deepseek-v4.1-flash
# OPENCODE_FALLBACK_MODELS=deepseek-v4-flash,glm-5.3

# ── External MCP docs server (Phase 4, optional) ─────────────────────────────
# v4+ can call a remote MCP server live. Default is DeepWiki, which answers
# questions about a GitHub repo's docs (no API key needed). Swap the URL for any
# other MCP server (e.g. Context7: https://mcp.context7.com/mcp).
# MCP_EXTERNAL_URL=https://mcp.deepwiki.com/mcp
# MCP_EXTERNAL_LABEL=DeepWiki (LangChain docs)
# MCP_EXTERNAL_ASK_TOOL=ask_wiki_question

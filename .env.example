# Copy this file to .env and fill in your key. NEVER commit the real .env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional: comma separated fallbacks used when the router/model is unavailable.
# Check https://openrouter.ai/models (filter: prompt price = free) for live IDs.
# OPENROUTER_FALLBACK_MODELS=openrouter/free,qwen/qwen-2.5-72b-instruct:free,meta-llama/llama-3.3-70b-instruct:free
